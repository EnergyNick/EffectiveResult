<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>EffectiveResult</PackageId>
        <Description>
          Implementation of the result monad pattern for an alternative way of handling errors.
        </Description>
        <Authors>Nickolay Sikachin</Authors>
        <Copyright>Copyright © Nickolay Sikachin 2025</Copyright>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/EnergyNick/EffectiveResult</PackageProjectUrl>

        <PackageVersion>1.0.0</PackageVersion>
        <PackageIcon>icon-128.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>
          Release version of library with main features and async extensions support
        </PackageReleaseNotes>
        <PackageTags>Result Monad Functional Pattern Error Handling Exception</PackageTags>
        <TargetFrameworks>net9.0;net8.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
        <None Include="..\..\icons\icon-128.png" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
